@charset "utf-8";

:root { --pk: #c8963c; --pk2: #e91e8c; --pkp: #fce4f3; --pkl: #f8bbd0; --blk: #0d0d0d; --wh: #fff; --gy: #f8f7f5; --bd: rgba(0,0,0,.08); --mt: #888; --gn: #27ae60; --rd: #e74c3c; --font-ar: 'Tajawal',sans-serif; --font-en: 'Inter',sans-serif; --font-serif: 'Cormorant Garamond',serif; }

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: var(--font-ar); color: rgb(26, 26, 26); background: var(--gy); }

button, select, input, textarea { font-family: inherit; }

button { cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid var(--bd); background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); }

.back { width: 38px; height: 38px; border-radius: 50%; background: var(--pkp); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }

.logo { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 600; }

.logo em { color: var(--pk); font-style: italic; }

.wrap { padding: 1.2rem; max-width: 600px; margin: 0px auto; }

.card { background: var(--wh); border-radius: 1rem; padding: 1.2rem; margin-bottom: 0.9rem; box-shadow: rgba(0, 0, 0, 0.04) 0px 2px 12px; }

.card-title { font-weight: 700; font-size: 0.9rem; margin-bottom: 0.9rem; display: flex; align-items: center; gap: 0.4rem; }

.fg { margin-bottom: 0.8rem; }

.fl { display: block; font-size: 0.74rem; font-weight: 600; color: var(--mt); margin-bottom: 0.27rem; }

.fi { width: 100%; padding: 0.65rem 0.88rem; border: 1.5px solid var(--bd); border-radius: 0.7rem; font-size: 0.84rem; }

.fi:focus { outline: none; border-color: var(--pk2); }

.frow { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; }

.sum-row { display: flex; justify-content: space-between; font-size: 0.83rem; padding: 0.32rem 0px; }

.sum-val { font-family: var(--font-en); }

.sum-row.tot { font-weight: 800; font-size: 1.05rem; color: var(--pk2); border-top: 1px solid var(--bd); padding-top: 0.55rem; margin-top: 0.35rem; }

.pay-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.55rem; }

.pay-opt { border: 1.5px solid var(--bd); border-radius: 0.9rem; padding: 0.8rem 0.55rem; text-align: center; font-size: 0.75rem; font-weight: 600; transition: 0.2s; cursor: pointer; }

.pay-opt.sel { border-color: var(--pk2); background: var(--pkp); box-shadow: rgba(233, 30, 140, 0.15) 0px 5px 15px; }

.pay-opt.dis { opacity: 0.35; cursor: default; }

.pay-ico { font-size: 1.3rem; display: block; margin-bottom: 0.28rem; }

.bank-box { background: var(--pkp); border-radius: 0.85rem; padding: 0.95rem; margin-top: 0.85rem; font-size: 0.8rem; }

.brow { display: flex; justify-content: space-between; padding: 0.25rem 0px; gap: 0.5rem; }

.brow b { font-family: var(--font-en); font-size: 0.78rem; word-break: break-all; }

.sub-btn { width: 100%; background: linear-gradient(135deg,var(--pk2),#8e24aa); color: rgb(255, 255, 255); padding: 1.05rem; border-radius: 3rem; font-weight: 700; font-size: 0.95rem; box-shadow: rgba(233, 30, 140, 0.3) 0px 14px 30px; }

.sub-btn:disabled { opacity: 0.5; }

.ov { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.55); display: none; align-items: center; justify-content: center; z-index: 2000; padding: 1.5rem; }

.ov.sh { display: flex; }

.popup { background: var(--wh); border-radius: 1.3rem; padding: 1.8rem; max-width: 330px; width: 100%; text-align: center; }

.popup h3 { font-family: var(--font-serif); margin-bottom: 0.55rem; font-size: 1.1rem; font-weight: 600; }

.popup p { color: var(--mt); font-size: 0.82rem; margin-bottom: 1.2rem; line-height: 1.7; }

.cp-links { display: flex; flex-direction: column; gap: 0.5rem; }

.cp-links a { padding: 0.8rem; border-radius: 0.8rem; background: var(--pkp); color: var(--pk2); font-weight: 600; font-size: 0.82rem; }

.pop-close { margin-top: 1rem; color: var(--mt); font-size: 0.77rem; cursor: pointer; }

.succ-ov { position: fixed; inset: 0px; background: var(--wh); z-index: 3000; display: none; align-items: center; justify-content: center; flex-direction: column; padding: 2rem; text-align: center; }

.succ-ov.sh { display: flex; }

.succ-emo { font-size: 4rem; margin-bottom: 1rem; }

.succ-ov h2 { font-family: var(--font-serif); margin-bottom: 0.55rem; font-weight: 400; font-size: 1.6rem; }

.succ-ov p { color: var(--mt); margin-bottom: 1.5rem; font-size: 0.85rem; }

.succ-btn { background: var(--pk2); color: var(--wh); padding: 0.9rem 2.2rem; border-radius: 3rem; font-weight: 700; display: inline-block; }

#toast { position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%); background: var(--blk); color: rgb(255, 255, 255); padding: 0.68rem 1.3rem; border-radius: 2rem; font-size: 0.79rem; display: none; z-index: 1000; }
