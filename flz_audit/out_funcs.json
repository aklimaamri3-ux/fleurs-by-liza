    {
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.prevent_non_admin_profiles_write()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nBEGIN\n  -- اتصال مباشر بالسيرفر (SQL Editor) → مسموح\n  IF current_setting('request.jwt.claims', true) IS NULL THEN\n    RETURN NEW;\n  END IF;\n  -- service_role (خادم موثوق) → مسموح\n  IF auth.role() = 'service_role' THEN\n    RETURN NEW;\n  END IF;\n  -- anon (زائر بلا حساب) → ممنوع\n  IF auth.uid() IS NULL THEN\n    RAISE EXCEPTION 'forbidden';\n  END IF;\n  -- مستخدم مسجل غير أدمن → ممنوع\n  PERFORM 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin';\n  IF NOT FOUND THEN\n    RAISE EXCEPTION 'forbidden';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n",
      "name": "prevent_non_admin_profiles_write",
      "schema": "public",
      "security_definer": true
    },
