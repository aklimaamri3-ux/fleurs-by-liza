      "def": "CREATE OR REPLACE FUNCTION public.generate_order_ref()\n RETURNS text\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n  new_ref TEXT;\n  chars TEXT := 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  i INT;\nBEGIN\n  LOOP\n    new_ref := 'FBL' || TO_CHAR(NOW(), 'YYYY') || '-';\n    FOR i IN 1..6 LOOP\n      new_ref := new_ref || SUBSTR(chars, FLOOR(RANDOM() * LENGTH(chars) + 1)::INT, 1);\n    END LOOP;\n    -- تأكد أنه فريد\n    EXIT WHEN NOT EXISTS (SELECT 1 FROM public.orders WHERE ref = new_ref);\n  END LOOP;\n  RETURN new_ref;\nEND;\n$function$\n",
      "name": "generate_order_ref",
      "schema": "public",
      "security_definer": false
    },
    {
      "args": "",
      "def": "CREATE OR REPLACE FUNCTION public.get_payment_info()\n RETURNS json\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  v json;\r\nBEGIN\r\n  SELECT value INTO v FROM public.settings WHERE key = 'payment';\r\n  -- نرجع فقط المعلومات اللي يحتاجها الزبون\r\n  RETURN json_build_object(\r\n    'holder',        v-\u003e\u003e'holder',\r\n    'ccp',           v-\u003e\u003e'ccp',\r\n    'baridimob',     v-\u003e\u003e'baridimob',\r\n    'eur_rate',      v-\u003e\u003e'eur_rate',\r\n    'iban',          v-\u003e\u003e'iban',\r\n    'swift',         v-\u003e\u003e'swift',\r\n    'iban_holder',   v-\u003e\u003e'iban_holder',\r\n    'binance_id',    v-\u003e\u003e'binance_id',\r\n    'binance_addr',  v-\u003e\u003e'binance_addr',\r\n    'binance_network', v-\u003e\u003e'binance_network',\r\n    'redotpay_id',   v-\u003e\u003e'redotpay_id',\r\n    'instagram',     v-\u003e\u003e'instagram'\r\n    -- ❌ whatsapp مش هنا — يُجلب من الأدمن فقط\r\n  );\r\nEND;\r\n$function$\n",
      "name": "get_payment_info",
      "schema": "public",
      "security_definer": true
