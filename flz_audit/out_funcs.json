      "def": "CREATE OR REPLACE FUNCTION public.orders_set_receipt_token()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n  IF NEW.receipt_token IS NULL THEN\r\n    NEW.receipt_token := replace(gen_random_uuid()::text, '-', '');\r\n  END IF;\r\n  RETURN NEW;\r\nEND; $function$\n",
