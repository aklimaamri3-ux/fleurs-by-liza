      "def": "CREATE OR REPLACE FUNCTION public.checkout_payment(p_method text)\n RETURNS jsonb\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nDECLARE\n  pay jsonb;\nBEGIN\n  SELECT value INTO pay FROM public.settings WHERE key = 'payment';\n  IF pay IS NULL THEN RETURN '{}'::jsonb; END IF;\n  RETURN CASE p_method\n    WHEN 'ccp'      THEN jsonb_build_object('holder', pay-\u003e\u003e'holder', 'ccp', pay-\u003e\u003e'ccp', 'baridimob', pay-\u003e\u003e'baridimob')\n    WHEN 'iban'     THEN jsonb_build_object('holder', pay-\u003e\u003e'holder', 'iban', pay-\u003e\u003e'iban', 'swift', pay-\u003e\u003e'swift', 'iban_holder', pay-\u003e\u003e'iban_holder')\n    WHEN 'binance'  THEN jsonb_build_object('binance_id', pay-\u003e\u003e'binance_id', 'binance_addr', pay-\u003e\u003e'binance_addr', 'network', 'TRC20')\n    WHEN 'redotpay' THEN jsonb_build_object('redotpay_id', pay-\u003e\u003e'redotpay_id')\n    ELSE '{}'::jsonb\n  END;\nEND;\n$function$\n",
      "name": "checkout_payment",
      "schema": "public",
      "security_definer": true
    },
