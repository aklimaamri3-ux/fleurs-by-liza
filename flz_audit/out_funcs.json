      "def": "CREATE OR REPLACE FUNCTION public.set_order_ref()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF NEW.ref IS NULL OR NEW.ref = '' THEN\n    NEW.ref := public.generate_order_ref();\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n",
